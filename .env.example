# Copie este arquivo para .env antes de subir o ambiente:
#   cp .env.example .env
#
# NENHUM valor real/segredo deve ser commitado. O arquivo .env está no
# .gitignore e permanece apenas na máquina local de cada desenvolvedor(a).

# --- Banco de dados (MariaDB) ---
MYSQL_DATABASE=reconectar
MYSQL_USER=reconectar
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=reconectar
WORDPRESS_DB_USER=reconectar
WORDPRESS_DB_PASSWORD=troque-esta-senha
WORDPRESS_TABLE_PREFIX=wp_

# --- Portas expostas no host (ajuste se houver conflito local) ---
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081

# --- Dados do administrador criado pelo script de provisionamento ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=troque-esta-senha
WP_ADMIN_EMAIL=admin@reconectar.local
WP_TITLE="Reconectar - Incubadora Digital"
WP_URL=http://localhost:8080

# --- Gateway de pagamento (Pix / Cartão / Boleto) ---
# Decisão de qual gateway usar (ex.: Mercado Pago, Asaas) ainda pendente pela equipe do projeto.
# NÃO inserir credenciais reais aqui nesta etapa.
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_ACCESS_TOKEN=
